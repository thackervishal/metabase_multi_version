# Metabase image tag.
# Use <major>.<minor>.<patch>.x to float on the latest bugfix patch,
# or <major>.<minor>.<patch>.<build> to pin to a specific build.
# Example: MB_IMAGE_TAG=1.61.1.x
MB_IMAGE_TAG=

# Host port for the Metabase UI. Must be unique across your locally running stacks.
METABASE_PORT=

# Host port for the Metabase app database (Postgres). Must be unique.
APP_DB_PORT=

# Host port for the sample data warehouse (Postgres). Must be unique.
SAMPLE_DB_PORT=

# Set to true to write one JSON file per LLM API call to ./metabot-debug-logs/<stack>/
METABOT_DEBUG_LLM=false

# Optional shared services. Set to true to enable; make start will spin them up automatically.
# ENABLE_EMAIL=false
# ENABLE_WEBHOOKS=false
# ENABLE_SAML=false

# Enable Metabot (AI assistant) for this stack, using the Anthropic key from
# env/common.env. Unlike the shared-service flags above, this spins up no
# extra container — it just adds compose/metabot-overlay.yml, which is what
# actually sets MB_METABOT_ENABLED and the LLM provider/key env vars. Leave
# false (or unset) to keep Metabot's Admin UI settings fully editable, e.g.
# to configure a different provider by hand.
# ENABLE_METABOT=false

# Enable Remote Sync (git-backed collection/library sync, EE-only) for this
# stack. When true, make start creates a local bare git repo, seeded with one
# empty commit on main, at data/remote-sync/<stack>/ (gitignored; removed on
# make nuke) and bind-mounts it into the container via
# compose/remote-sync-overlay.yml, which also sets
# MB_REMOTE_SYNC_URL=file:///remote-sync/repo.git and
# MB_REMOTE_SYNC_TYPE=read-write — so Admin > Remote Sync shows a repo already
# connected, ready to push to. Deliberately does NOT touch
# remote-sync-transforms (no env-var equivalent exists for it) or which
# collections sync — turn those on yourself in the Admin UI once you're in.
# Also clones a normal (non-bare, browsable) working-tree copy of that repo
# to data/remote-sync-checkout/<stack>/ — the bare repo itself has no visible
# files, so this is what to open in VSCode/Explorer to see synced content;
# run `git pull` inside it by hand to refresh after a push.
# ENABLE_REMOTE_SYNC=false

# Host port for Trino's coordinator (JDBC/UI). Must be unique. Only read when
# ENABLE_TRINO=true.
# TRINO_PORT=

# Enable Trino as a query-engine layer in front of this stack's sample-pg15
# Postgres, for testing Metabase's connection-impersonation feature against
# Trino's own file-based access control (no Ranger involved — see
# .github/agent-trino-impersonation.md). Adds compose/trino-overlay.yml and a
# generated Postgres catalog at data/trino-config/<stack>/catalog/ (safe to
# regenerate, derived entirely from this stack's own env vars). The
# access-control rules.json under data/trino-config/<stack>/access-control/
# is seeded ONCE from seed/trino/access-control/rules.example.json and never
# overwritten after that — it's yours to hand-edit (impersonation rules,
# table/row restrictions). Currently only wired up for the sample-pg15
# dataset.
# ENABLE_TRINO=false

# Optional friendly name shown by `make list` and the stack picker, e.g. "testing keycloak".
# Purely cosmetic — does not affect the env filename, ports, or any other stack identity.
# STACK_LABEL=

# Automation admin API key, unique to this stack. Baked into Metabase's app_db
# at first boot (see seed/metabase/config-*.yml) so scripts, MCP, and the mb
# CLI can authenticate immediately. `make new` generates this automatically —
# only needed here if you're creating this file by hand.
# Generate with: echo "mb_$(openssl rand -base64 32)"
MB_AUTOMATION_API_KEY=
