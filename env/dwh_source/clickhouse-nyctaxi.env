DATASET=clickhouse-nyctaxi
DATASET_NAME="NYC Taxi (ClickHouse)"
SAMPLE_DB_DISPLAY_NAME=nyc_taxi_clickhouse
SAMPLE_DB_TYPE=ClickHouse

# Not a metabase/qa-databases image (no pre-seeded ClickHouse QA image exists) —
# official upstream image, matches the tag Metabase's own ClickHouse driver
# test suite uses (modules/drivers/clickhouse/docker-compose.yml).
SAMPLE_DB_IMAGE=clickhouse/clickhouse-server:latest-alpine

SAMPLE_DB_NAME=default
SAMPLE_DB_USER=metabase
SAMPLE_DB_PASSWORD=metasample123

METABASE_CONFIG_FILE=config-clickhouse.yml
