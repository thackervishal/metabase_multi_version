STACK_PROJECT_PREFIX=mb

# Shared services ports (Mailpit, webhook tester, Keycloak).
# Only relevant when the corresponding ENABLE_* flag is set in a stack env file.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# WEBHOOK_PORT=9000
# KEYCLOAK_PORT=8180

# Optional on Windows when jq.exe is installed outside PATH.
# JQ_BIN=/c/path/to/jq.exe

MB_PREMIUM_EMBEDDING_TOKEN=replace-with-your-metabase-token
MB_LOAD_SAMPLE_CONTENT=false

MB_APP_DB_NAME=metabaseappdb
MB_APP_DB_USER=metabase
MB_APP_DB_PASSWORD=metabase_app_password

MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=metabot1
MB_ANALYST_EMAIL=analyst@example.com
MB_ANALYST_PASSWORD=metabot1
MB_SALES_EMAIL=sales@example.com
MB_SALES_PASSWORD=metabot1

# Fallback only — each stack now generates its own MB_AUTOMATION_API_KEY in
# env/mb_versions/<version>.env via `make new` (see template.env.example).
# This value is used only if a stack's version env file doesn't set one.
MB_AUTOMATION_API_KEY=replace-with-random-key  # echo "mb_$(openssl rand -base64 32)"
MB_ENCRYPTION_SECRET_KEY=replace-with-random-secret  # openssl rand -base64 32

SAMPLE_DB_DISPLAY_NAME="${DATASET//-/_}"
MB_SITE_NAME="Metabase ${MB_VERSION} Local Stack"
MB_APPLICATION_NAME="${MB_VERSION} Metabase"
MB_ANALYTICS_PII_RETENTION_ENABLED=true
MB_CHECK_FOR_UPDATES=false
MB_ENABLE_EMBEDDING_INTERACTIVE=true
MB_ENABLE_EMBEDDING_SIMPLE=true
MB_ENABLE_EMBEDDING_SDK=true
MB_ENABLE_EMBEDDING_STATIC=true
MB_EMBEDDING_SECRET_KEY=0123456789abcdef0123456789abcdef
MB_SDK_ENCRYPTION_VALIDATION_KEY=0123456789abcdef0123456789abcdef
MB_EMBEDDING_APP_ORIGINS_INTERACTIVE="http://localhost:3000 http://localhost:3001 http://127.0.0.1:3000 http://127.0.0.1:3001"
MB_EMBEDDING_APP_ORIGINS_SDK="http://localhost:3000 http://localhost:3001 http://127.0.0.1:3000 http://127.0.0.1:3001"
MB_PERSISTED_MODELS_ENABLED=true
MB_QUERY_CACHING_MAX_KB=10240
MB_QUERY_CACHING_MAX_TTL=3600
DEFAULT_CACHE_POLICY_DURATION=1
DEFAULT_CACHE_POLICY_UNIT=hours
DEFAULT_CACHE_POLICY_REFRESH_AUTOMATICALLY=false
DATABASE_CACHE_POLICY_DURATION=1
DATABASE_CACHE_POLICY_UNIT=hours
DATABASE_CACHE_POLICY_REFRESH_AUTOMATICALLY=false
MB_TRANSFORMS_ENABLED=true
MB_AI_FEATURES_ENABLED=true
MB_METABOT_ENABLED=true
MB_LLM_METABOT_PROVIDER=anthropic/claude-sonnet-4-6
# Optional: set this in env/common.env to enable Anthropic-backed Metabot locally.
# MB_LLM_ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Point the in-app Store settings (store-url, store-api-url — used by the
# "Migrate to Cloud" flow, license/token checks, upsells) at the staging
# store instead of prod. Maps directly to Metabase's own MB_STORE_USE_STAGING
# env var (metabase.cloud-migration.settings/store-use-staging).
MB_STORE_USE_STAGING=true